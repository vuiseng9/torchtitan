    "version": "0.2.0",
    "configurations": [
        {
            "name": "hf flux generate",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {},
            "cwd": "${workspaceFolder}/torchtitan",
            "program": "torchtitan/experiments/flux/hf_flux.py",
            "args": []
        },
        {
            "name": "Attach torchrun",
            "type": "debugpy",
            "preLaunchTask": "launch-torchrun-and-ready-cue",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "vs-py",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {},
            "cwd": "${workspaceFolder}",
            "program": "${file}",
            "args": []
        },
    ]
}